{
  "name": "@agentprodready/agent-framework",
  "version": "1.8.0",
  "description": "TypeScript agent orchestration entrance (createAgent, createTeam) — durable memory/HITL/stream replay when you need them. Production-oriented architecture, young ecosystem — not a graph DSL.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "keywords": [
    "ai",
    "agents",
    "ai-agent",
    "llm-agent",
    "agentic-ai",
    "agent-framework",
    "llm",
    "openai",
    "anthropic",
    "typescript",
    "nodejs",
    "createAgent",
    "streaming",
    "tools",
    "memory",
    "multi-agent",
    "production-ai"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@agentprodready/ai-provider": "workspace:*",
    "@agentprodready/audit": "workspace:*",
    "@agentprodready/capability-resolution": "workspace:*",
    "@agentprodready/composition": "workspace:*",
    "@agentprodready/context-assembly": "workspace:*",
    "@agentprodready/evaluation": "workspace:*",
    "@agentprodready/event-bus": "workspace:*",
    "@agentprodready/foundation": "workspace:*",
    "@agentprodready/knowledge": "workspace:*",
    "@agentprodready/memory": "workspace:*",
    "@agentprodready/multi-agent": "workspace:*",
    "@agentprodready/planning": "workspace:*",
    "@agentprodready/plugin-framework": "workspace:*",
    "@agentprodready/prompt-builder": "workspace:*",
    "@agentprodready/runtime": "workspace:*",
    "@agentprodready/security": "workspace:*",
    "@agentprodready/tool-framework": "workspace:*",
    "@agentprodready/workflow": "workspace:*"
  },
  "peerDependencies": {
    "@agentprodready/ai-provider-openai": "^1.0.2",
    "@agentprodready/ai-provider-anthropic": "^1.0.0",
    "@agentprodready/ai-provider-gemini": "^1.0.0",
    "@agentprodready/persistence-postgres": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@agentprodready/ai-provider-openai": {
      "optional": true
    },
    "@agentprodready/ai-provider-anthropic": {
      "optional": true
    },
    "@agentprodready/ai-provider-gemini": {
      "optional": true
    },
    "@agentprodready/persistence-postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentprodready/ai-provider-openai": "workspace:*",
    "@agentprodready/ai-provider-anthropic": "workspace:*",
    "@agentprodready/ai-provider-gemini": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameenmari/agentprodready.git"
  },
  "homepage": "https://github.com/ameenmari/agentprodready#readme",
  "bugs": {
    "url": "https://github.com/ameenmari/agentprodready/issues"
  }
}
