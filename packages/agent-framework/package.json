{
  "name": "@agentprodready/agent-framework",
  "version": "1.3.0",

  "description": "Build an AI agent in minutes. Add production controls when you need them. Simple Agent API (createAgent) plus advanced Agent Framework.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "keywords": [
    "ai",
    "agents",
    "agent-framework",
    "llm",
    "openai",
    "typescript",
    "nodejs",
    "createAgent",
    "streaming",
    "tools",
    "memory"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@agentprodready/ai-provider": "workspace:*",
    "@agentprodready/audit": "workspace:*",
    "@agentprodready/capability-resolution": "workspace:*",
    "@agentprodready/composition": "workspace:*",
    "@agentprodready/context-assembly": "workspace:*",
    "@agentprodready/evaluation": "workspace:*",
    "@agentprodready/event-bus": "workspace:*",
    "@agentprodready/foundation": "workspace:*",
    "@agentprodready/knowledge": "workspace:*",
    "@agentprodready/memory": "workspace:*",
    "@agentprodready/planning": "workspace:*",
    "@agentprodready/plugin-framework": "workspace:*",
    "@agentprodready/prompt-builder": "workspace:*",
    "@agentprodready/runtime": "workspace:*",
    "@agentprodready/security": "workspace:*",
    "@agentprodready/tool-framework": "workspace:*",
    "@agentprodready/workflow": "workspace:*"
  },
  "peerDependencies": {
    "@agentprodready/ai-provider-openai": "^1.0.2"
  },
  "peerDependenciesMeta": {
    "@agentprodready/ai-provider-openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentprodready/ai-provider-openai": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameenmari/agentprodready.git"
  },
  "homepage": "https://github.com/ameenmari/agentprodready#readme",
  "bugs": {
    "url": "https://github.com/ameenmari/agentprodready/issues"
  }
}
