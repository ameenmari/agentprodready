{
  "name": "@agentprodready/runtime",
  "version": "1.1.1",
  "description": "Runtime execution for AgentProdReady — timeout, cancel, checkpoint, recover, stream. Core engine behind createAgent (not a graph DSL).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "keywords": [
    "runtime",
    "agent-runtime",
    "streaming",
    "checkpoints",
    "production-ai",
    "ai-agent",
    "agentprodready",
    "typescript",
    "nodejs"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@agentprodready/foundation": "workspace:*",
    "@agentprodready/composition": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameenmari/agentprodready.git"
  },
  "homepage": "https://github.com/ameenmari/agentprodready#readme",
  "bugs": {
    "url": "https://github.com/ameenmari/agentprodready/issues"
  }
}
