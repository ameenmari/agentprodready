{
  "name": "@agentprodready/knowledge",
  "version": "1.0.2",
  "description": "Knowledge and RAG-oriented retrieval contracts for AgentProdReady hosts (distinct from execution-derived Memory).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "keywords": [
    "rag",
    "knowledge",
    "retrieval",
    "llm",
    "ai-agent",
    "agentprodready",
    "typescript",
    "nodejs"
  ],
  "dependencies": {
    "@agentprodready/ai-provider": "workspace:*",
    "@agentprodready/capability-resolution": "workspace:*",
    "@agentprodready/foundation": "workspace:*",
    "@agentprodready/plugin-framework": "workspace:*",
    "@agentprodready/workflow": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameenmari/agentprodready.git"
  },
  "homepage": "https://github.com/ameenmari/agentprodready#readme",
  "bugs": {
    "url": "https://github.com/ameenmari/agentprodready/issues"
  }
}
