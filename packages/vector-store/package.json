{
  "name": "@agentprodready/vector-store",
  "version": "1.0.2",
  "description": "Provider-independent vector store contracts for AgentProdReady semantic and hybrid memory search.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "!dist/**/*.spec.js",
    "!dist/**/*.spec.d.ts",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "keywords": [
    "vector-store",
    "vector-search",
    "embeddings",
    "rag",
    "similarity-search",
    "agentprodready",
    "typescript",
    "nodejs"
  ],
  "dependencies": {
    "@agentprodready/foundation": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameenmari/agentprodready.git"
  },
  "homepage": "https://github.com/ameenmari/agentprodready#readme",
  "bugs": {
    "url": "https://github.com/ameenmari/agentprodready/issues"
  }
}
