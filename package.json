{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsc -b --watch --preserveWatchOutput",
    "start": "pnpm --filter @agentforge/platform-host start",
    "smoke": "pnpm --filter @agentforge/platform-host smoke",
    "lint": "eslint . --max-warnings 0 && pnpm boundaries",
    "boundaries": "node scripts/verify-boundaries.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.eslint.json --pretty false && tsc -b --pretty false",
    "test": "vitest run --coverage",
    "build": "tsc -b --pretty false",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "prettier --check .",
    "db:up": "docker compose --profile postgres up -d postgres",
    "db:down": "docker compose --profile postgres down",
    "db:migrate": "pnpm --filter @agentforge/persistence-postgres exec node dist/cli.js migrate",
    "db:status": "pnpm --filter @agentforge/persistence-postgres exec node dist/cli.js status",
    "db:reset:test": "pnpm --filter @agentforge/persistence-postgres exec node dist/cli.js reset",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:runtime-recovery": "node scripts/run-runtime-recovery-tests.mjs",
    "test:memory-persistence": "node scripts/run-memory-persistence-tests.mjs",
    "test:evaluation-persistence": "node scripts/run-evaluation-persistence-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
