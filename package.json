{
  "name": "agentforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsc -b --watch --preserveWatchOutput",
    "start": "pnpm --filter @agentforge/platform-host start",
    "smoke": "pnpm --filter @agentforge/platform-host smoke",
    "lint": "eslint . --max-warnings 0 && pnpm boundaries",
    "boundaries": "node scripts/verify-boundaries.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.eslint.json --pretty false && tsc -b --pretty false",
    "test": "vitest run --coverage",
    "build": "tsc -b --pretty false",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
