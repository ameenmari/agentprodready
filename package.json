{
  "name": "agentprodready",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsc -b --watch --preserveWatchOutput",
    "start": "pnpm --filter @agentprodready/platform-host start",
    "smoke": "pnpm --filter @agentprodready/platform-host smoke",
    "lint": "eslint . --max-warnings 0 && pnpm boundaries",
    "boundaries": "node scripts/verify-boundaries.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.eslint.json --pretty false && tsc -b --pretty false",
    "test": "vitest run --coverage",
    "build": "tsc -b --pretty false",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format:check": "prettier --check .",
    "db:up": "docker compose --profile postgres up -d postgres",
    "db:down": "docker compose --profile postgres down",
    "db:migrate": "pnpm --filter @agentprodready/persistence-postgres exec node dist/cli.js migrate",
    "db:status": "pnpm --filter @agentprodready/persistence-postgres exec node dist/cli.js status",
    "db:reset:test": "pnpm --filter @agentprodready/persistence-postgres exec node dist/cli.js reset",
    "db:migrate:vector": "pnpm --filter @agentprodready/vector-store-pgvector exec node dist/cli.js migrate",
    "db:status:vector": "pnpm --filter @agentprodready/vector-store-pgvector exec node dist/cli.js status",
    "test:postgres": "node scripts/run-postgres-tests.mjs",
    "test:vector-pgvector": "node scripts/run-vector-pgvector-tests.mjs",
    "test:vector-search": "node scripts/run-vector-search-tests.mjs",
    "test:runtime-recovery": "node scripts/run-runtime-recovery-tests.mjs",
    "test:memory-persistence": "node scripts/run-memory-persistence-tests.mjs",
    "test:evaluation-persistence": "node scripts/run-evaluation-persistence-tests.mjs",
    "test:streaming": "node scripts/run-streaming-tests.mjs",
    "test:tools": "node scripts/run-tools-tests.mjs",
    "test:routing": "node scripts/run-routing-tests.mjs",
    "test:tenant-isolation": "pnpm exec vitest run apps/platform-host/src/tenant-isolation.spec.ts",
    "test:public-dx": "node scripts/test-public-dx.mjs",
    "test:scaffold-dx": "node scripts/test-scaffold-dx.mjs",
    "verify-versioning": "node scripts/verify-versioning.mjs",
    "verify-package-readmes": "node scripts/verify-package-readmes.mjs",
    "production-baseline": "node scripts/production-baseline.mjs",
    "npm:audit": "node scripts/npm-publish-audit.mjs",
    "npm:pack:dry": "node scripts/npm-publish.mjs --dry-run",
    "npm:publish": "node scripts/npm-publish.mjs --publish"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  }
}
