# AgentProdReady v1.0 Local Reference Product
# Copy to .env only if you need overrides. Defaults work for pnpm start
# (reference AI, in-memory persistence, in-memory Memory, evaluation off, vector search off).

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
REFERENCE_AGENT_ENABLED=true

# AI provider selection: reference (default, deterministic) | openai
AI_PROVIDER=reference

# v1.0 multi-provider routing (Capability Resolution ordered fallback; no AiRouter)
# fixed = v0.9 single-provider behavior | fallback = try primary then AI_FALLBACK_PROVIDERS
AI_ROUTING_MODE=fixed
# Comma-separated secondaries when AI_ROUTING_MODE=fallback (reference | openai; required if fallback)
# AI_FALLBACK_PROVIDERS=openai

# Required only when AI_PROVIDER=openai (never commit real keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# Opt-in live package tests (never enabled in default CI)
# AI_LIVE_TESTS=1

# Persistence provider selection: in-memory (default) | postgres
PERSISTENCE_PROVIDER=in-memory

# Required only when PERSISTENCE_PROVIDER=postgres (never commit real credentials)
# DATABASE_URL=postgres://agentprodready:agentprodready@127.0.0.1:5432/agentprodready
# POSTGRES_SSL=false
# POSTGRES_POOL_MIN=0
# POSTGRES_POOL_MAX=10
# Alternate discrete URL parts (used only when DATABASE_URL is absent):
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DATABASE=agentprodready
# POSTGRES_USER=agentprodready
# POSTGRES_PASSWORD=agentprodready

# Destructive local/test DB reset guard for pnpm db:reset:test
# PERSISTENCE_ALLOW_RESET=1

# Runtime restart recovery (default false). When true, host boot calls Runtime.recoverIncomplete
# after persistence readiness. Cross-process durability requires PERSISTENCE_PROVIDER=postgres.
# With in-memory persistence, recovery is allowed for tests but checkpoints do not survive process restart.
RUNTIME_RECOVERY_ENABLED=false

# Memory provider selection: in-memory (default) | persistent
# persistent uses PersistenceBackedMemoryProvider over the selected Persistence provider.
# There is no MEMORY_PROVIDER=postgres. Cross-process durable Memory requires:
#   MEMORY_PROVIDER=persistent + PERSISTENCE_PROVIDER=postgres
MEMORY_PROVIDER=in-memory

# Evaluation Framework (Blueprint 14) host wiring — off by default.
# When true, Composition builds EvaluationFramework with local reference evaluators.
EVALUATION_ENABLED=false
# Result store: in-memory (default) | persistent
# persistent uses Persistence repository evaluation-results (tenant-only scope).
# Cross-process durable results require EVALUATION_RESULT_STORE=persistent + PERSISTENCE_PROVIDER=postgres.
EVALUATION_RESULT_STORE=in-memory

# Vector search / semantic Memory (default off). When enabled, config must match a profile.
VECTOR_SEARCH_ENABLED=false
VECTOR_STORE_PROVIDER=none
EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=reference-embedding-32
# EMBEDDING_DIMENSIONS=32
# VECTOR_INDEX_PROFILE=reference-32
# Vector schema migration (separate from Persistence):
#   VECTOR_INDEX_PROFILE=reference-32 pnpm db:migrate:vector
# OpenAI embedding profile (opt-in; reuses OPENAI_API_KEY):
#   EMBEDDING_PROVIDER=openai EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIMENSIONS=1536 VECTOR_INDEX_PROFILE=openai-1536-small VECTOR_STORE_PROVIDER=pgvector

# Streaming (v0.8 SSE /invoke/stream)
STREAMING_HEARTBEAT_INTERVAL_MS=15000
STREAMING_MAX_DRAIN_WAIT_MS=30000

# Tool calling / agent actions (v0.9) — off by default
TOOLS_ENABLED=false
TOOL_MAX_CALLS_PER_INVOCATION=8
TOOL_MAX_TURNS=4
TOOL_MAX_ARGUMENT_BYTES=16384
TOOL_MAX_RESULT_BYTES=65536

# v1.0 production hardening
# Graceful shutdown drain timeout for in-flight invoke + SSE (ms)
SHUTDOWN_TIMEOUT_MS=30000
# Max JSON request body size (bytes); default 1 MiB
MAX_JSON_BODY_BYTES=1048576
# When NODE_ENV=production, LocalReference auth fails startup unless this is true (unsafe demo only)
AGENTPRODREADY_ALLOW_REFERENCE_AUTH=false

# Docker / Compose must use:
# HOST=0.0.0.0
