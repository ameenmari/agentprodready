# AgentForge v0.2 Local Reference Product
# Copy to .env only if you need overrides. Defaults work for pnpm start (reference AI).

HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
REFERENCE_AGENT_ENABLED=true

# AI provider selection: reference (default, deterministic) | openai
AI_PROVIDER=reference

# Required only when AI_PROVIDER=openai (never commit real keys)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# Opt-in live package tests (never enabled in default CI)
# AI_LIVE_TESTS=1

# Docker / Compose must use:
# HOST=0.0.0.0
