      "@agentprodready/ai-provider-gemini": ["packages/ai-provider-gemini/src/index.ts"],
      "@agentprodready/tool-framework": ["packages/tool-framework/src/index.ts"],
      "@agentprodready/knowledge": ["packages/knowledge/src/index.ts"],
